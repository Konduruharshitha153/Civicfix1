# CivicFix Environment Variables
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=civicfix-super-secret-jwt-key-2026-production-grade
JWT_SECRET_KEY=civicfix-jwt-access-refresh-secret-key-32chars-min

# PostgreSQL Database Configuration
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civicfix_db

# Fallback SQLite DB path if PostgreSQL is not used
# DATABASE_URL=sqlite:///civicfix.db

# File Uploads Directory (Relative to backend/ or Absolute)
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216  # 16 MB max upload size

# Geocoding / Location Defaults (Bengaluru / City Center default coords)
DEFAULT_LATITUDE=12.9716
DEFAULT_LONGITUDE=77.5946

# AI / ML Settings
SIMILARITY_DUPLICATE_THRESHOLD=0.65
MAX_DUPLICATE_DISTANCE_METERS=350.0
